{
  "manifest_version": 3,
  "name": "Box VDR Extractor",
  "version": "1.1.0",
  "description": "Extract documents from Box Virtual Data Room as PDF",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://*.box.com/*", "https://*.app.box.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["extractor.js", "diagnostic.js"],
    "matches": ["https://*.box.com/*"]
  }]
}
